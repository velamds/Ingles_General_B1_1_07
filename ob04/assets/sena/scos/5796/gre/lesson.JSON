[{"type": "text", "content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">Compare yourself to the audio.</span>"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le07ob04re2img01.jpg", "audiosrc": "engenn6le07ob04re2aud01", "images": [{"time": "0", "image": "engenn6le07ob04re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le07ob04re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Jesse</span>: Which building do you work in exactly?</br>\n<span class=\"strong\">Samantha</span>: The tall one over there with the glass front- the one glimmering in the sunlight with the modern exterior.</br>\n<span class=\"strong\">Jesse</span>: Nice.  This location in much better than the one in Midtown."}, {"time": "11000", "image": "engenn6le07ob04re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Samantha</span>: Yes, the restaurants are much better too. By the way, there is a new rooftop terrace restaurant opening in that building. It supposedly has the best views in the city and a renowned chef from London.</br>\n<span class=\"strong\">Jesse</span>: We ought to check it out. </br>\n<span class=\"strong\">Samantha</span>: We should."}, {"time": "27500", "image": "engenn6le07ob04re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Jesse</span>: Are you busy next Saturday?  I can make reservations for say ... 8 PM? Do you wanna go?</br>\n<span class=\"strong\">Samantha</span>: Sounds good but you will have to book soon.  I'm sure it will be popular. Jenny and I are going to a street fair near City Hall in the afternoon.  They're going to be live bands and giveaways."}, {"time": "45000", "image": "engenn6le07ob04re2img01.jpg", "id": 4, "text": "<span class=\"strong\">Jesse</span>: Nice. Maybe I can meet you two there and then we can head to dinner after?</br>\n<span class=\"strong\">Samantha</span>: Great idea! I've gotta  pick up my new glasses too. Jenny says they look glamorous.</br>\n<span class=\"strong\">Jesse</span>: You hafta wear them at dinner. So you can look fabulous and enjoy the city skyline at the same time."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter Goes on a Blind Date"}, {"type": "unit_name", "content": "Glad, Glass, Glee"}, {"type": "position", "content": 4}, {"type": "origin", "content": "scholar > Grammar - part 3 > Are You Tracy?"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}]}, {"type": "background_image", "content": "engenn6le07ob04re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Consonant Clusters - GL Sound"}, {"type": "describer", "content": "Consonant clusters like gl can occur at the beginning of a word in English. </p> Practice blending the sound from one consonant sound into the next without adding a vowel sound in between."}, {"type": "text", "content": "Look at the chart below."}, {"type": "table", "content": "{\"rows\":2,\"columns\":5,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glue\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glum\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glee\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glass\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glow\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glove\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glitch\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"gleen\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"glamour\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"gloat\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "The building over there, with the glass front."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Reduced forms "}, {"type": "describer", "content": "You use reduced forms in speaking, not in writing."}, {"type": "text", "content": "See the table below for examples."}, {"type": "table", "content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Formal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Reduced Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ought to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"otta\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"want to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"wanna\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"have to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"hafta\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"got to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"gotta\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"going to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"gonna\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"going to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"goin'ta\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "Do you wanna go?"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to glimmer "}, {"type": "definition", "content": "to shine in a weak, unsteady way"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The front of the building was glimmering in the sunlight."}, {"type": "audio", "content": "engenn6le07ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use in a conversation between friends."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to open"}, {"type": "definition", "content": "to start operating"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: There is a new restaurant opening in that building next week."}, {"type": "audio", "content": "engenn6le07ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Midtown"}, {"type": "definition", "content": "an area within a city between the city core and northern or southern areas."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are a lot of nice shops in Midtown."}, {"type": "audio", "content": "engenn6le07ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "terrace"}, {"type": "definition", "content": "a flat area where people can sit and relax"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's have a drink on the terrace."}, {"type": "audio", "content": "engenn6le07ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to head to"}, {"type": "definition", "content": "to be going or directed somewhere"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: We can head to the restaurants afterwards."}, {"type": "audio", "content": "engenn6le07ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "giveaway"}, {"type": "definition", "content": "something that is given away for free"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There is live music and giveaways."}, {"type": "audio", "content": "engenn6le07ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "glamorous"}, {"type": "definition", "content": "very exciting and attractive"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Those  glasses make you look so glamorous."}, {"type": "audio", "content": "engenn6le07ob04aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Complete a 2 minute role play between you and a partner about planning a get together with friends at a restaurant."}, {"type": "text", "content": "Describe the restaurant. What does it look like?"}, {"type": "text", "content": "Use the words <span class=\"italic\">have to</span>, <span class=\"italic\">got to</span>, and <span class=\"italic\">ought to</span> in both formal and reduced forms."}, {"type": "text", "content": "Include 4 words with the consonant blend gl sound."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I complete a 2 minute role play about a get together."}, {"type": "text", "content": "I describe a building."}, {"type": "text", "content": "I use formal and informal language in role plays."}]}]}