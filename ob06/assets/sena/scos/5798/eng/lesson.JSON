ontent": "take", "type": "text"}], "selected": 0, "text": "", "correct": 0}, {"id": 59, "_data": [{"content": "it", "type": "text"}], "selected": 0, "text": "", "correct": 0}, {"id": 60, "_data": [{"content": "back", "type": "text"}], "selected": 0, "text": "", "correct": 0}, {"id": 61, "_data": [{"content": "!", "type": "text"}], "selected": 0, "text": "", "correct": 0}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"tool-tip\" id=\"tip_11_0\">Technically</span>, are those technical words?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}, {"content": [{"content": "<span class=\"italic\">\"Technically\"</span> is an adverb used to mean things like <span class=\"italic\">officially</span>, <span class=\"italic\">actually</span> and <span class=\"italic\">really</span>.", "type": "text", "tip_id": 0}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Select all the technical computer related words or phrases in the paragraph. ", "type": "text"}, {"content": "You have 2 attempts to submit your answers.", "type": "text"}]}], "type": "SLS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le07ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Saul</span>: Hello, Fordy's Computers, IT Department. This is Saul speaking. How can I help you?</br>\n<span class=\"strong\">Peter</span>: Hello Saul. I just bought this laptop! I really hope you guys will take it back.  I can't figure out all the gadgets on this thing!</br>\n<span class=\"strong\">Saul</span>: Well, before we consider that, what seems to be the current issue? We should be able to fix it.", "id": 1, "time": "100", "image": "engenn6le07ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Peter</span>: Amazing, I'd be grateful! It seems to freeze up all the time. I am turning it on right now. Still frozen!</br>\n<span class=\"strong\">Saul</span>: I'll try to troubleshoot with you. Try pressing the \u201cesc\u201d key.</br>\n<span class=\"strong\">Peter</span>: I really appreciate your assistance, but this is not working. I also clear my cache all the time. It's useless!", "id": 2, "time": "17300", "image": "engenn6le07ob07re2img05.jpg"}, {"text": "<span class=\"strong\">Saul</span>: Here's what I would do. Try shutting everything down. Then restart and try running your computer for a while without the external hard drive.</br>\n<span class=\"strong\">Peter</span>: I will need this thing working soon. I'm going to a meeting tomorrow. The keyboard seems to turn off at times.</br>\n<span class=\"strong\">Saul</span>: Why don't you reset it to the original settings?</br>\n<span class=\"strong\">Peter</span>: Sounds great! Let me see what that does. It works! Thank you so much!", "id": 3, "time": "37400", "image": "engenn6le07ob07re2img05.jpg"}], "audiosrc": "engenn6le07ob06re2aud01", "coverimg": "engenn6le07ob06re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}