p_name", "content": "Activity 1"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}]}, {"type": "tips", "content": [{"tip_id": 0, "content": "\"<span class=\"italic\">Technically</span>\" - This is an adverb used to mean things like, officially, actually and really.", "type": "text"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Select all the technical computer related words or phrases in the paragraph. "}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le07ob06re2img01.jpg", "audiosrc": "engenn6le07ob06re2aud01", "images": [{"time": "0", "image": "engenn6le07ob06re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le07ob06re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Saul</span>: Hello, Fordy's Computers, IT Department. This is Saul speaking. How can I help you?</br>\n<span class=\"strong\">Peter</span>: Hello Saul. I just bought this laptop! I really hope you guys will take it back.  I can't figure out all the gadgets on this thing!</br>\n<span class=\"strong\">Saul</span>: Well, before we consider that, what seems to be the current issue? We should be able to fix it."}, {"time": "17300", "image": "engenn6le07ob07re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Peter</span>: Amazing, I'd be grateful! It seems to freeze up all the time. I am turning it on right now. Still frozen!</br>\n<span class=\"strong\">Saul</span>: I'll try to troubleshoot with you. Try pressing the \u201cesc\u201d key.</br>\n<span class=\"strong\">Peter</span>: I really appreciate your assistance, but this is not working. I also clear my cache all the time. It's useless!"}, {"time": "37400", "image": "engenn6le07ob07re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Saul</span>: Here's what I would do. Try shutting everything down. Then restart and try running your computer for a while without the external hard drive.</br>\n<span class=\"strong\">Peter</span>: I will need this thing working soon. I'm going to a meeting tomorrow. The keyboard seems to turn off at times.</br>\n<span class=\"strong\">Saul</span>: Why don't you reset it to the original settings?</br>\n<span class=\"strong\">Peter</span>: Sounds great! Let me see what that does. It works! Thank you so much!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}