emplate_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le07ob05re2img05.jpg", "audiosrc": "engenn6le07ob05re2aud01", "images": [{"time": "0", "image": "engenn6le07ob05re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le07ob05re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter</span>: I'm nervous about calling Tracy. I'd better wait till later.</br>\n<span class=\"strong\">Robert</span>: You're asking her out again right! You should just call. You'll do great! You ought to do it right now! </br>\n<span class=\"strong\">Peter</span>: Yeah, I know. Okay. Here goes. I don't believe it! My phone isn't working!</br>\n<span class=\"strong\">Robert</span>: You'd better call the phone company. Here, use my phone.</br>\n<span class=\"strong\">Peter</span>: You're right. Thanks."}, {"time": "25500", "image": "engenn6le07ob05re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Telephone Technician</span>: Hello, City Phones. How can I help you?</br>\n<span class=\"strong\">Peter</span>: I can't get a connection on my phone. All I hear is crackling. There's only interference.</br>\n<span class=\"strong\">Telephone Technician</span>: You should try turning your phone off, then on again.</br>\n<span class=\"strong\">Peter</span>: Ok. I've done that. Can you do anything at your end?"}, {"time": "43500", "image": "engenn6le07ob05re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Telephone Technician</span>: OK, I'm going to check the connection from here. I'll just troubleshoot your line.</br>\n<span class=\"strong\">Peter</span>: Oh! That worked! Thank you!</br>\n<span class=\"strong\">Telephone Technician</span>: I'm glad to help. Can I do anything else for you?</br>\n<span class=\"strong\">Peter</span>: No thanks. I appreciate your help. Bye. I'll call Tracy right now before it dies again!</br>\n<span class=\"strong\">Robert</span>: Good idea.</br>\n<span class=\"strong\">Peter</span>: Uh, hi Tracy? It's Peter Smith. I'm calling to see if you want to go out this weekend."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter Goes on a Blind Date"}, {"type": "unit_name", "content": "Phone Troubles"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}]}, {"type": "background_image", "content": "engenn6le07ob05re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Describing and Solving a Technical Problem"}, {"type": "describer", "content": "When you have a problem with your cell phone you call the company for help. You ask them to help you find a solution to the problem."}, {"type": "example", "content": "<span class=\"strong\">George</span>: My phone isn't working.   </br>        <span class=\"strong\">Phone agent</span>: Have you tried turning it on and off?"}, {"type": "example", "content": "<span class=\"strong\">George</span>: Whenever I use my phone I hear crackling.    </br>      <span class=\"strong\">Phone Agent</span>: I suggest you bring the phone in. "}, {"type": "table", "content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Describing a Problem\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Solving a Problem\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It seems to ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Try resetting the ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm having problems ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Did you try ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The screen always ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Try...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Whenever I use the ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I suggest ...\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Responding Politely to Suggestions"}, {"type": "describer", "content": "When you are given a suggestion, you should always respond in a <span class=\"strong italic\">polite</span> way. "}, {"type": "example", "content": "<span class=\"strong\">James</span>: You ought to call her right now!</br>  <span class=\"strong\">Andrew</span>:  Yeah, I know. "}, {"type": "example", "content": "<span class=\"strong\">James</span>: You ought to call here this afternoon.</br> <span class=\"strong\">Andrew</span>: You're right. I should."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Suggestion\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Polite Response\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You should try turning your phone off then on again.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Ok. I've done that.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You ought to do that right now! </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Yeah, I know. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You'd better call the phone company. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You're right.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "connection"}, {"type": "definition", "content": "something that joins or connects two or more things"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: During the storm, they lost their phone connection."}, {"type": "audio", "content": "engenn6le07ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you are having phone troubles."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "interference"}, {"type": "definition", "content": "signals that weaken or block a phone conversation"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There was too much interference on the phone to hear what she was saying."}, {"type": "audio", "content": "engenn6le07ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "crackling"}, {"type": "definition", "content": "making snapping sounds"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: All I heard on my phone was crackling."}, {"type": "audio", "content": "engenn6le07ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to troubleshoot"}, {"type": "definition", "content": "to find out why something isn't working correctly"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I can try troubleshooting from here."}, {"type": "audio", "content": "engenn6le07ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "at your end"}, {"type": "definition", "content": "from your side"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Can you do anything from your end?"}, {"type": "audio", "content": "engenn6le07ob05aud05"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of five technical problems you could have with their computer or phone."}, {"type": "text", "content": "Write a set of questions to ask the technician."}, {"type": "text", "content": "Write solutions to the problems beside the questions."}, {"type": "text", "content": "Read you questions aloud."}, {"type": "text", "content": "Practice them until they sound natural."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I  prepare questions related to technical problems."}, {"type": "text", "content": "I  write questions about the problems."}, {"type": "text", "content": "I  write solutions."}, {"type": "text", "content": "I  practice my questions aloud."}]}]}