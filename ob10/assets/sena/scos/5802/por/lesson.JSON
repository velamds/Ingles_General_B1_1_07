condary_8"}]}, {"responses": [{"correct": 0, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": "rarely"}]}], "id": 3, "_data": [{"type": "question", "contents": [{"type": "text", "content": "<span class=\"strong\">Karen</span>: No,  "}, {"type": "audio", "content": "engenn6le07ob10re6aud05"}]}, {"type": "post_question", "contents": {"type": "", "content": "."}}, {"type": "objective", "content": "secondary_8"}]}], "type": "TYP", "id": 10, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \n Joe and Karen talk about Joe's trip to Europe."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Use capital letters when necessary.</span>    \n"}]}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "type": "RSLT", "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le07ob10re2img01.jpg", "audiosrc": "engenn6le07ob10re2aud01", "images": [{"time": "0", "image": "engenn6le07ob10re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn6le07ob10re2img01.jpg", "text": "<span class=\"strong\">Tom</span>: So I'm finally meeting the real Tracy Tuesday night?<br>\n<span class=\"strong\">Peter</span>: I guarantee you Doug, this time it will work out!  I'm feeling completely positive about it!<br>\n<span class=\"strong\">Tom</span>: What are your plans?", "id": 1}, {"time": "10500", "image": "engenn6le07ob10re2img01.jpg", "text": "<span class=\"strong\">Peter</span>: Well, we are going to see that new romantic comedy movie Tuesday.<br>\n<span class=\"strong\">Tom</span>: That's a good idea. What else are you going to do that evening?<br>\n<span class=\"strong\">Peter</span>: We're having dinner at Le Bistrot de Robert. After dinner, we're taking a carriage ride around the park. Then we're going to the movie. I thrive on the excitement. I just need to get rid of any fears. How do you conquer your fears?", "id": 2}, {"time": "35000", "image": "engenn6le07ob10re2img01.jpg", "text": "<span class=\"strong\">Tom</span>: I frequently take a walk, sit in the park or read a book, then feed the birds. <br>\n<span class=\"strong\">Peter</span>: That sounds nice. I routinely do meditation. That helps me relax!  You should try it!<br>\n<span class=\"strong\">Peter</span>: Hello, Tracy? ... Well, undoubtedly, Tuesday will be one of your best nights ever! \u2026 I'm greatly looking forward to it too.  Bye!<br>\n<span class=\"strong\">Tom</span>: Ah, that's so sweet!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter Goes on a Blind Date"}, {"type": "unit_name", "content": "The Real Tracy"}, {"type": "position", "content": 10}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}]}, {"type": "background_image", "content": "engenn6le07ob10re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Adverbs of Manner"}, {"type": "describer", "content": "You use adverbs of manner to describe how something is done. <br> Example: <span class=\"italic\">She strongly voiced her concerns. How did she voice her concerns? Strongly.</span>"}, {"type": "text", "content": "Many adverbs are formed by adding <span class=\"strong\">-ly</span> to an adjective: <br> Examples: routine \u2192 routinely             quick \u2192 quickly"}, {"type": "text", "content": "Some adverbs are formed by adding <span class=\"strong\">-ally</span><br> Example:  public \u2192  publically"}, {"type": "text", "content": "These adverbs can come after the direct object or after the verb if there isn't any direct object."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Habits and Routines"}, {"type": "describer", "content": "When you talk about someone's habits and routines, you use the Simple Present tense and frequency words."}, {"type": "text", "content": "You use expressions of frequency to say how many times you do an activity."}, {"type": "text", "content": "This can be an adverb like <span class=\"italic\">often</span>, <span class=\"italic\">sometimes</span> or <span class=\"italic\">never</span>. "}, {"type": "text", "content": "It can also be an expression like <span class=\"italic\">a lot</span>, <span class=\"italic\">all the time</span> or<span class=\"italic\"> when I can</span>."}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adverbs\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Expressions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"always<br> usually<br> often<br> sometimes<br> occasionally<br> hardly ever<br> never\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"every day/week/month<br> most of the time<br> every other day/week/month<br> once in a while<br> from time to time<br> when ...\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "Perry usually walks in the park. "}, {"type": "example", "content": "Carol always gives good advice."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to guarantee "}, {"type": "definition", "content": "to promise that something is true or real  "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I guarantee you Doug, this time it will work out!"}, {"type": "audio", "content": "engenn6le07ob10aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when talking about people's routines."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to thrive "}, {"type": "definition", "content": "to grow or develop successfully "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I thrive on the excitement."}, {"type": "audio", "content": "engenn6le07ob10aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "routinely"}, {"type": "definition", "content": "a regular way of doing things in a particular order "}, {"type": "part_speech", "content": " (adverb)"}, {"type": "example", "content": "Example: I routinely do meditation."}, {"type": "audio", "content": "engenn6le07ob10aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to get rid of "}, {"type": "definition", "content": "to no longer have, want, or need something or someone "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  I just need to get rid of any fears."}, {"type": "audio", "content": "engenn6le07ob10aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "undoubtedly "}, {"type": "definition", "content": "definitely true or existing "}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: Undoubtedly, this will be one of your best nights ever!"}, {"type": "audio", "content": "engenn6le07ob10aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "frequently"}, {"type": "definition", "content": "happens often "}, {"type": "part_speech", "content": " (adverb)"}, {"type": "example", "content": "Example: I frequently sit in the park or read a book."}, {"type": "audio", "content": "engenn6le07ob10aud05-2"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to take a walk "}, {"type": "definition", "content": " to walk without a purpose "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I frequently take a walk to relax. "}, {"type": "audio", "content": "engenn6le07ob10aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Role-play a situation. Talk about your plans for going out on a blind date."}, {"type": "text", "content": "Your partner will play the role of your friend."}, {"type": "text", "content": "Use the Present progressive tense to talk about plans."}, {"type": "text", "content": "Use adverbs of manner to describe how things happen."}, {"type": "text", "content": "Change roles."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I do a role-play."}, {"type": "text", "content": "I talk about future plans."}, {"type": "text", "content": "I describe how things happen."}, {"type": "text", "content": "I change roles."}]}]}